# Host-level nginx vhost for a preprod stack running ALONGSIDE production on
# the same VPS (skip this file entirely if preprod lives on its own server —
# there, just reuse appdevops.nginx.conf.example as-is).
#
# Assumes the preprod docker-compose.deploy.yml stack publishes its client
# on 127.0.0.1:8081 (CLIENT_PORT=8081 in .env.preprod) so it never collides
# with production's 127.0.0.1:8080.
#
#   sudo ln -s /etc/nginx/sites-available/appdevops-preprod /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d preprod.your-domain.example

server {
    listen 80;
    listen [::]:80;
    server_name preprod.your-domain.example;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
