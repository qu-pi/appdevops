# Copy to ".env.preprod" or ".env.prod" on each server and fill in real,
# environment-specific values. Never commit the filled-in file.
#
# Usage on the server (see docker-compose.deploy.yml for details):
#   docker compose -p appdevops-<env> -f docker-compose.deploy.yml --env-file .env.<env> pull
#   docker compose -p appdevops-<env> -f docker-compose.deploy.yml --env-file .env.<env> up -d

# --- Image source ----------------------------------------------------------
# Your GHCR namespace, e.g. the GitHub org/user that owns this repo.
GHCR_OWNER=qu-pi
# Set by the CD workflow at deploy time; a fixed value here is only a
# fallback for manual `docker compose up` runs.
IMAGE_TAG=latest

# --- MySQL -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=taskmanager
DB_USER=taskmanager_user
DB_PASSWORD=change_me_password
# Use a different host port per environment if both stacks run on the same VPS.
DB_PORT=3306

# --- Server (Express API) -----------------------------------------------
SERVER_PORT=3001
# The real public URL of THIS environment (preprod or prod).
CLIENT_ORIGIN=https://change-me.example

# --- Client (nginx) ------------------------------------------------------
# Use a different host port per environment if both stacks run on the same VPS.
CLIENT_PORT=8080
