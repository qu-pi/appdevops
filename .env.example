# Copy to ".env" and fill in real values before running `docker compose up`.

# --- MySQL ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=taskmanager
DB_USER=taskmanager_user
DB_PASSWORD=change_me_password
DB_PORT=3307

# --- Server (Express API) -------------------------------------------------
SERVER_PORT=3001
# In production, set this to the real public URL (e.g. https://your-domain.example)
CLIENT_ORIGIN=http://localhost:8080

# --- Auth -----------------------------------------------------------------
# Long random secret used to sign login tokens (e.g. `openssl rand -hex 32`).
# Changing it logs every user out.
JWT_SECRET=change_me_long_random_secret
# Admin account created at server boot if it doesn't exist yet (an existing
# account with this email is promoted to admin). The password is only used
# on creation; changing it here afterwards has no effect.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# --- Client (Vite build arg, baked into the static bundle) ---------------
# Relative path works out of the box: nginx proxies /api/* to the server
# container (see client/nginx.conf).
VITE_API_URL=/api/tasks
CLIENT_PORT=8080
